# Copy to .env.staging and replace every placeholder with dedicated staging values.
# This file is ignored by git. Never place production project credentials here.
APP_ENV=staging
NODE_ENV=production
WHATSAPP_RESERVATION_WORKER_ENABLED=false
API_HOST=127.0.0.1
API_PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:4200

STAGING_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-server-only-key
SESSION_SECRET=replace-with-a-unique-staging-secret-at-least-32-characters
ADMIN_EMAIL=staging-admin@example.invalid
ADMIN_PASSWORD=replace-with-a-unique-staging-admin-password

STAGING_API_URL=http://127.0.0.1:3000/api
STAGING_TEST_PRODUCT_ID=00000000-0000-4000-8000-000000000000
